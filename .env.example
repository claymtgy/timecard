# Copy to .env and adjust. Both services read .env from the working directory.

# --- Shared -----------------------------------------------------------------
# One database is fine: the IdP uses schema "idp", the app uses schema "app".
DATABASE_URL=postgres://crm:crm@localhost:5432/crm?sslmode=disable

# --- Identity provider (cmd/idp) ---------------------------------------------
IDP_ADDR=:8081
IDP_ISSUER=http://localhost:8081
# 32+ random characters; used to encrypt opaque tokens. Generate: openssl rand -hex 32
IDP_CRYPTO_KEY=dev-only-change-me-dev-only-change-me
# Allow self-service sign-up on the login page (turn off in production).
IDP_ALLOW_SIGNUP=true
# Set when served over HTTPS so cookies get the Secure flag.
IDP_SECURE_COOKIES=false

# OIDC client registered for the web app (upserted on IdP start-up).
IDP_APP_CLIENT_ID=crm-web
IDP_APP_CLIENT_SECRET=dev-secret-change-me
IDP_APP_REDIRECT_URIS=http://localhost:5173/auth/callback,http://localhost:8080/auth/callback
IDP_APP_POST_LOGOUT_URIS=http://localhost:5173/,http://localhost:8080/

# --- Web app (cmd/app) -----------------------------------------------------
APP_ADDR=:8080
# Public URL the browser uses. In dev that's the Vite server, which proxies /api and /auth.
APP_URL=http://localhost:5173
APP_SECURE_COOKIES=false
# Directory with the built Vue app (npm run build in web/). Empty = API only.
APP_WEB_DIST=web/dist
# Company time zone: clock-in/out times are turned into dates and hours in this zone.
APP_TIMEZONE=America/Denver
OIDC_ISSUER=http://localhost:8081
OIDC_CLIENT_ID=crm-web
OIDC_CLIENT_SECRET=dev-secret-change-me

# --- Email (sending invoices) -------------------------------------------------
# Dev: docker compose runs Mailpit — nothing is delivered; view mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Crew Timesheets <billing@example.com>"
