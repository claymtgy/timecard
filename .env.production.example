# Production settings for docker-compose.prod.yml. Copy to .env.production and fill in.
# Generate secrets with:  openssl rand -hex 32
# (hex keeps them URL-safe — POSTGRES_PASSWORD is embedded in a connection URL)

APP_DOMAIN=timecard.clayton-montgomery.dev
AUTH_DOMAIN=auth.clayton-montgomery.dev

POSTGRES_PASSWORD=
IDP_CRYPTO_KEY=
OIDC_CLIENT_SECRET=

# Leave false: create accounts with `idp user add` (see README → Deploying).
# If you turn it on, anyone who can reach the sign-in page can register.
IDP_ALLOW_SIGNUP=false

# Clock-in times become dates/hours in this zone.
APP_TIMEZONE=America/Denver

# Email for sending invoices (optional — without it invoices are PDF download only).
# Port 465 = implicit TLS; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Clayton Montgomery <billing@clayton-montgomery.dev>"
